@using DemoCrudWithEF.Domain.Commands
@using DemoCrudWithEF.Domain.Repositories
@using DemoCrudWithEF.Models


@inject IAlbumRepository _albumRepository

<div class="row">
    <div class="col-md-4">
        <h3>Add Album : </h3>
        <EditForm EditContext="EditContext" OnValidSubmit="Submit">
            <DataAnnotationsValidator></DataAnnotationsValidator>
            <ValidationSummary Model="Form"></ValidationSummary>
            <div class="form-group">
                <label class="control-label">Code :</label>
                <InputText @bind-Value="Form.Titre" class="form-control" />
                <ValidationMessage For="() => Form.Titre" class="text-danger" />
            </div>
            <div class="form-group">
                <label class="control-label">Code :</label>
                <InputNumber @bind-Value="Form.Annee" class="form-control" />
                <ValidationMessage For="() => Form.Annee" class="text-danger" />
            </div>
            <div class="form-group">
                <input type="submit" value="Ajouter Submit" class="btn btn-primary" />
                <button type="button" @onclick="Submit" class="btn btn-secondary">Ajouter</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public AddAlbumForm Form { get; set; } = default!;

    private EditContext EditContext = default!;

    protected override void OnInitialized()
    {
        EditContext = new EditContext(Form);
    }

    private async Task Submit()
    {
        if (EditContext.Validate())
        {
            await _albumRepository.HandleAsync(new CreateAlbumCommand(Form.Titre, Form.Annee, Form.GroupeId), CancellationToken.None);
        }
    }
}
